{
  "name": "lodge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:ui": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/crew/*.test.js ui/src/goal-island/*.test.js",
    "eval:planning": "node evals/planning/run.mjs",
    "samples:generate": "node scripts/generate-samples.mjs",
    "samples:export": "node scripts/export-sample.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "8.3.4"
  }
}
