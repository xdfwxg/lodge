{
  "name": "lodge",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first delivery workbench for multi-agent rooms, evidence and handoff.",
  "author": "Lodge",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:ui": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "test": "node --test server/crew/*.test.js ui/src/goal-island/*.test.js ui/src/approval-card.test.js ui/src/delivery-sheet.test.js",
    "eval:planning": "node evals/planning/run.mjs",
    "samples:generate": "node scripts/generate-samples.mjs",
    "samples:export": "node scripts/export-sample.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "electron": "^43.8.8",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "vite": "8.3.4"
  }
}
