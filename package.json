{
  "name": "lodge",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first delivery workbench for multi-agent rooms, evidence and handoff.",
  "author": "Lodge",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,green \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "advisor:serve": "node server/advisor-service.mjs",
    "dev:ui": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "prepare:runtimes": "node scripts/prepare-runtimes.mjs",
    "prepare:base": "node scripts/prepare-base.mjs",
    "package:mac": "npm run prepare:runtimes && npm run prepare:base && npm run build && electron-builder --mac --publish never",
    "package:mac:dir": "npm run prepare:runtimes && npm run prepare:base && npm run build && electron-builder --mac dir --publish never",
    "package:win": "npm run prepare:runtimes && npm run build && electron-builder --win --publish never",
    "package:linux": "npm run prepare:runtimes && npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "test:e2e": "node --test server/crew/e2e-room.test.js",
    "test": "node scripts/test.mjs",
    "eval:planning": "node evals/planning/run.mjs",
    "eval:chat": "node scripts/eval-chat.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:regressions": "node scripts/check-regressions.mjs",
    "data:restore": "node scripts/data-restore.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.5",
    "electron": "^43.8.8",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "vite": "8.3.4"
  }
}
