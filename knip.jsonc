{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "electron/preload.cjs",
    "scripts/**/*.mjs",
    "evals/**/run.mjs",
    "evals/**/worker.mjs",
    "evals/**/make-fixtures.mjs",
    "evals/**/checks/**/*.mjs",
    "evals/**/tools/**/*.mjs",
    "evals/**/fixtures/**/*.{js,mjs}",
    "e2e/**/*.spec.mjs"
  ],
  "project": [
    "server/**/*.js",
    "shared/**/*.js",
    "ui/src/**/*.js",
    "scripts/**/*.mjs",
    "evals/**/*.mjs",
    "e2e/**/*.mjs",
    "electron/**/*.{js,mjs,cjs}"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "pi"
  ],
  // pi 会把 typebox 映射给它自己的副本，扩展按需 import；这不是 Lodge 的依赖。
  "ignoreDependencies": [
    "typebox"
  ],
  // workspace provider 的方法通过运行时接口取用，静态分析看不到调用方。
  "ignoreIssues": {
    "server/crew/workspace-direct.js": ["exports"],
    "server/crew/workspace-plain.js": ["exports"]
  }
}
